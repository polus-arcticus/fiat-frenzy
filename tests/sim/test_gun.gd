## Sim tests: gun. Each test_* method is run by tests/run.gd, which reseeds the RNG before it.
extends TestCase


func test_bills_fly_land_and_get_picked_up() -> void:
	note("bills: printed money is an object, in flight and then lying in the street")
	var w := World.new()
	var p := w.add_player(Vector2.ZERO, 0.0)
	var b := w.gun.fire(2.0, "gift")
	check(w.ledger.printed == 2.0 and w.bills.size() == 1 and not b.loose and is_equal_approx(w.total_money(), w.ledger.printed), "firing prints it into the world: in flight, and accounted for")
	check(w.cash.collect_for_player() == 0.0, "a bill in the air can't be picked up")
	var landed := w.gun.land(b, Vector2(6, 0))
	check(b.loose and landed == b and b.mode == "cash", "landing makes it loose cash")
	check(w.cash.collect_for_player() == 0.0, "out of reach: nothing")
	p.pos = Vector2(5.0, 0)
	var got := w.cash.collect_for_player()
	check(is_equal_approx(got, 2.0) and is_equal_approx(w.ledger.player_cash, 2.0) and w.bills.is_empty(), "walking over it picks it up: $%.0f" % got)
	check(is_equal_approx(w.total_money(), w.ledger.printed), "and it is all accounted for")
	var a1 := w.gun.fire(2.0, "gift")
	var a2 := w.gun.fire(2.0, "gift")
	w.gun.land(a1, Vector2(20, 20))
	var pile := w.gun.land(a2, Vector2(20.5, 20))
	check(pile == a1 and is_equal_approx(a1.value, 4.0) and w.bills.size() == 1, "bills landing together make one pile worth $4")
	w.gun.land(w.gun.fire(2.0, "gift"), Vector2(40, 40))
	check(w.bills.size() == 2, "and ones that land apart stay apart")


func test_bills_hit_people() -> void:
	note("bills: a gift bill that hits is a gift; any other falls as cash")
	var w := World.new()
	var vendor := w.add_vendor("hot_dog_stand", Vector2(0, 0), 0.0, false, false)
	var drifter := w.add_drifter(Vector2(5, 0))
	var g := w.gun.fire(2.0, "gift")
	var r := w.gun.hit(g, drifter)
	check(r.result == "gift" and drifter.wallet == 2.0 and drifter.rep > 0.0 and w.bills.is_empty(), "a gift bill that hits someone is theirs, and earns rep")
	var stray := w.gun.fire(2.0, "cash")
	r = w.gun.hit(stray, drifter)
	check(r.result == "dropped" and stray.loose and stray.mode == "cash" and stray.pos == drifter.pos and drifter.wallet == 2.0, "a bill that is not a gift drops at their feet as cash")
	check(is_equal_approx(w.total_money(), w.ledger.printed), "no money lost on the way")


func test_npcs_pick_up_loose_cash() -> void:
	note("cash: idle NPCs notice loose money nearby and fetch it")
	var w := World.new()
	var d := w.add_drifter(Vector2(0, 0), 0.0)
	d.bars = Fixtures.bars(1.0, 1.0, 1.0)
	check(w.needs.demands(d).is_empty(), "a drifter with nothing to want wants nothing")
	var far := w.gun.fire(2.0, "gift")
	w.gun.land(far, Vector2(40, 0))
	check(w.needs.demands(d).is_empty(), "money 40 m away is beyond their notice")
	w.bills.erase(far)
	w.ledger.printed -= 2.0
	var b := w.gun.fire(4.0, "gift")
	w.gun.land(b, Vector2(9, 0))
	check(w.needs.demands(d) == ["cash"], "money 9 m away is a demand: cash")
	var t := Fixtures.until(w, func(): return d.wallet > 0.0, 60)
	note("    picked it up after %d s, wallet $%.2f, rep %.3f" % [t, d.wallet, d.rep])
	check(t >= 4 and t <= 8 and is_equal_approx(d.wallet, 4.0) and w.bills.is_empty(), "they walked over and picked it up")
	check(d.rep > 0.0, "and thought a little better of the player for it")
	check(is_equal_approx(w.total_money(), w.ledger.printed), "conserved")
	var w2 := World.new()
	var x := w2.add_drifter(Vector2(0, 0))
	var y := w2.add_drifter(Vector2(0, 2))
	x.bars = Fixtures.bars(1.0, 1.0, 1.0)
	y.bars = Fixtures.bars(1.0, 1.0, 1.0)
	w2.gun.land(w2.gun.fire(2.0, "gift"), Vector2(0, 8))
	Fixtures.run(w2, 30)
	check(is_equal_approx(x.wallet + y.wallet, 2.0) and w2.bills.is_empty(), "two drifters, one bill: it is taken once")
	var w3 := World.new()
	var baker := w3.add_vendor("bakery", Vector2(20, 0))
	var hungry := w3.add_drifter(Vector2(0, 0), 0.5)
	hungry.bars = Fixtures.bars(0.2, 1.0, 1.0)
	w3.gun.land(w3.gun.fire(4.0, "gift"), Vector2(4, 0))
	check(w3.needs.demands(hungry) == ["food", "cash"], "hungry and broke beside some cash: food, then cash")
	check(w3.logistics.plan(hungry)["for"] == "cash", "bread is out of reach for 50c, so they go for the cash")
	Fixtures.run(w3, 80)
	check(w3.machine_of(baker).sold_total > 0 and hungry.bars.hunger > 0.3, "and with it they go and buy the bread")


func test_gift_earns_rep() -> void:
	note("gun, gift mode: money for nothing, and rep, stochastically")
	var w := World.new()
	var big := w.add_drifter(Vector2.ZERO)
	var small := w.add_drifter(Vector2.ZERO)
	for i in 10:
		w.gun.gift(big, 50.0)
		w.gun.gift(small, 1.0)
	note("    rep after ten gifts: $50 each %.3f, $1 each %.3f" % [big.rep, small.rep])
	check(big.rep > small.rep * 5.0 and big.rep <= 1.0, "bigger gifts earn far more rep")
	var a := w.add_drifter(Vector2.ZERO)
	var b := w.add_drifter(Vector2.ZERO)
	w.gun.gift(a, 50.0)
	w.gun.gift(b, 50.0)
	check(not is_equal_approx(a.rep, b.rep), "and the same gift doesn't always earn the same")
	check(is_equal_approx(w.ledger.printed, 10 * 51.0 + 100.0) and is_equal_approx(w.total_money(), w.ledger.printed), "the money was printed, and it is all accounted for")


func test_invest_buys_a_stake() -> void:
	note("gun, invest mode: buy a share of a vendor's business, priced off the experience it has had")
	var w := World.new()
	var v := w.add_vendor("hot_dog_stand", Vector2(0, 0))
	var stand := w.machine_of(v)
	check(is_equal_approx(stand.value(), 40.0), "an untried stand is worth what it costs to rebuild: $40")
	var stake := w.gun.invest(v, 20.0)
	check(is_equal_approx(stake, 1.0 / 3.0) and is_equal_approx(stand.equity.stake, 1.0 / 3.0), "$20 into a $40 business buys a third of it (20 of 60)")
	check(is_equal_approx(v.wallet, 20.0) and is_equal_approx(w.ledger.printed, 20.0) and w.ledger.player_cash == 0.0, "the money went to the vendor, printed for nothing")
	check(is_equal_approx(stand.value(), 60.0) and is_equal_approx(v.growth.xp, 20.0), "and it counts as experience for them, so the business is now worth $60")
	var drifter := w.add_drifter(Vector2.ZERO)
	check(w.gun.invest(drifter, 40.0) == -1.0 and drifter.wallet == 0.0 and is_equal_approx(w.ledger.printed, 20.0), "there is nothing to buy into on a drifter, and nothing is printed")


func test_investment_is_capped_at_49_percent() -> void:
	note("invest: never more than 49% of a business")
	var w := World.new()
	var v := w.add_vendor("hot_dog_stand", Vector2(0, 0))
	var stand := w.machine_of(v)
	w.gun.invest(v, 20.0)
	var room := stand.investable()
	check(is_equal_approx(room, (0.49 - 1.0 / 3.0) * 60.0 / 0.51), "with a third owned, $%.2f more can still be invested" % room)
	var r := w.gun.invest_ex(v, 100.0)
	check(is_equal_approx(r.accepted, room) and is_equal_approx(r.stake, 0.49) and is_equal_approx(stand.equity.stake, 0.49), "a $100 offer only buys what fits: $%.2f, taking the stake to exactly 49%%" % r.accepted)
	check(is_equal_approx(w.ledger.printed, 20.0 + room), "and only the money that was spent was printed")
	r = w.gun.invest_ex(v, 50.0)
	check(r.accepted == 0.0 and is_equal_approx(r.stake, 0.49) and is_equal_approx(w.ledger.printed, 20.0 + room) and stand.investable() == 0.0, "at the cap, further offers are refused and nothing is printed")
	check(w.gun.invest(v, 5.0) == stand.equity.stake, "(invest still reports the stake, 49%, so it isn't mistaken for 'no business')")
	w.gun.gift(v, 100.0)
	check(stand.investable() == 0.0, "at 49%% the player stays maxed out however much the business grows: the cap is on the share")
	var w3 := World.new()
	var v3 := w3.add_vendor("hot_dog_stand", Vector2(0, 0))
	w3.gun.invest(v3, 20.0)
	var before := w3.machine_of(v3).investable()
	w3.gun.gift(v3, 100.0)
	check(w3.machine_of(v3).investable() > before * 2.0, "while a part-owned business that has been given money takes more to reach the cap ($%.2f, up from $%.2f)" % [w3.machine_of(v3).investable(), before])
	var w2 := World.new()
	var v2 := w2.add_vendor("hot_dog_stand", Vector2(0, 0))
	w2.gun.invest(v2, 20.0)
	var printed := w2.ledger.printed
	var big := w2.gun.fire_contract(50.0)
	var hit := w2.gun.hit_contract(big, v2)
	check(hit.result == "invest" and is_equal_approx(hit.amount, room) and is_equal_approx(hit.voided, 50.0 - room), "a contract bigger than the room buys what fits...")
	check(w2.bills.is_empty() and is_equal_approx(w2.ledger.printed, printed + room), "...and the rest is void: nothing is left lying about, and only the $%.2f that was accepted is printed" % room)
	check(is_equal_approx(w2.total_money(), w2.ledger.printed), "no money lost")
	var again := w2.gun.hit_contract(w2.gun.fire_contract(20.0), v2)
	check(again.result == "void" and is_equal_approx(again.voided, 20.0) and w2.bills.is_empty() and is_equal_approx(w2.ledger.printed, printed + room), "and once capped a contract is simply void")


func test_contracts_are_not_money_and_never_land() -> void:
	note("contracts: an offer, not cash. Reaching a business it buys a stake; anywhere else it is void")
	var w := World.new()
	var vendor := w.add_vendor("hot_dog_stand", Vector2(0, 0), 0.0, false, false)
	var drifter := w.add_drifter(Vector2(5, 0))
	var c := w.gun.fire_contract(20.0)
	check(w.bills.is_empty() and w.ledger.printed == 0.0, "spitting a contract prints nothing and puts nothing on the ground")
	var r := w.gun.hit_contract(c, vendor)
	check(r.result == "invest" and is_equal_approx(r.stake, 1.0 / 3.0) and vendor.wallet == 20.0 and is_equal_approx(w.ledger.printed, 20.0), "a contract that hits a vendor buys a third of the stand with $20, and that $20 is printed")
	var r2 := w.gun.hit_contract(w.gun.fire_contract(20.0), drifter)
	check(r2.result == "void" and r2.stake == -1.0 and drifter.wallet == 0.0 and w.bills.is_empty(), "one that hits a drifter has nothing to buy into: void, not dropped")
	w.gun.discard(w.gun.fire_contract(100.0))
	check(w.bills.is_empty() and is_equal_approx(w.ledger.printed, 20.0) and is_equal_approx(w.total_money(), w.ledger.printed), "a contract that misses is void: nothing printed, nothing left behind, money conserved")


func test_stake_earns_a_share_of_takings_forever() -> void:
	note("invest: the stake gets its share of the takings on every sale, with no end")
	var w := World.new()
	var v := w.add_vendor("bakery", Vector2(0, 0))
	var bakery := w.machine_of(v)
	bakery.price = 6.0
	w.add_relief_truck(Vector2(5, -5))  # flour delivered, so the bakery can keep baking
	var stake0 := w.gun.invest(v, 40.0)
	Fixtures.hungry_crowd(w, 6)
	Fixtures.run(w, 300)
	note("    %d sales, takings %.2f, player cash %.2f, stake %.2f" % [bakery.sold_total, bakery.revenue_total, w.ledger.player_cash, bakery.equity.stake])
	check(bakery.sold_total > 0 and w.ledger.player_cash > 0.0, "the player earns cash flow")
	check(is_equal_approx(w.ledger.player_cash, bakery.equity.stake * bakery.revenue_total), "exactly their stake of the takings on those sales")
	var after_first := w.ledger.player_cash
	Fixtures.hungry_crowd(w, 6)
	Fixtures.run(w, 600)
	check(w.ledger.player_cash > after_first, "and it keeps coming: there is no debt to pay off")
	check(bakery.equity.stake == stake0, "the stake never shrinks")
	check(is_equal_approx(w.total_money(), w.ledger.printed), "no money appeared or vanished")


func test_investing_gets_a_broken_stand_going() -> void:
	note("invest: the money lets a broken-down vendor open for business")
	var w := World.new()
	var v := w.add_vendor("hot_dog_stand", Vector2(0, 0), 20.0, false, false)
	var stand := w.machine_of(v)
	Fixtures.run(w, 30, true)
	check(not stand.working, "short of the money, the stand stays shut")
	w.gun.invest(v, 40.0)
	Fixtures.run(w, 3, true)
	check(stand.working and is_equal_approx(w.ledger.sunk, stand.repair_cost), "with the player's money it was repaired")
	Fixtures.run(w, 200, true)
	check(stand.stock() > 0 and stand.equity.stake > 0.4, "and it makes hot dogs, nearly half of whose takings belong to the player")
