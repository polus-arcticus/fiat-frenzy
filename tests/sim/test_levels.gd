## Sim tests: levels. Each test_* method is run by tests/run.gd, which reseeds the RNG before it.
extends TestCase


func test_experience_levels_up_the_business() -> void:
	note("experience: money given fills a bar; each level costs more, and expands the shop")
	check(Growth.need(1) == 50.0 and Growth.need(2) == 75.0 and Growth.need(3) > Growth.need(2) and Growth.need(4) > Growth.need(3), "each level takes more than the one before: 50, 75, 112.50, ...")
	check(Growth.total_for(1) == 0.0 and Growth.total_for(2) == 50.0 and Growth.total_for(3) == 125.0 and is_equal_approx(Growth.total_for(4), 237.5), "so levels 2, 3, 4 are reached at $50, $125, $237.50")
	var g := Growth.new()
	check(g.add(49.9) == 0 and g.level == 1 and g.progress() > 0.99, "$49.90 in: still level 1, the bar almost full")
	check(g.add(0.1) == 1 and g.level == 2 and is_equal_approx(g.progress(), 0.0), "the next dime fills it: level 2, the bar empty again")
	check(g.add(60.0) == 0 and g.level == 2 and is_equal_approx(g.progress(), 60.0 / 75.0), "$60 more is 80%% of level 2's cost")
	var spill := Growth.new()
	check(spill.add(60.0) == 1 and is_equal_approx(spill.progress(), 10.0 / 75.0), "a big gift that overfills the bar spills over: $60 is level 2 plus 10/75 toward level 3")
	check(Growth.new().add(100000.0) == Growth.MAX_LEVEL - 1, "there is a top level (%d)" % Growth.MAX_LEVEL)
	var w := World.new()
	var v := w.add_vendor("hot_dog_stand", Vector2(0, 0), 5.0, false, false)
	var stand := w.machine_of(v)
	check(stand.growth == v.growth and stand.level == 1 and v.growth.xp == 0.0, "a vendor and their stand share one growth, and a starting wallet is not experience")
	check(is_equal_approx(stand.rate_per_min, 6.0) and stand.capacity() == 20 and stand.input.caps["bread"] == 6, "level 1: 6 a minute, shelf of 20, six crafts of bread")
	w.gun.gift(v, 49.0)
	check(stand.level == 1 and w.events.is_empty(), "$49 given: nothing yet")
	w.gun.gift(v, 1.0)
	check(stand.level == 2 and is_equal_approx(stand.rate_per_min, 7.5) and stand.capacity() == 30 and stand.input.caps["bread"] == 7 and stand.input.caps["protein"] == 7, "the dollar that fills the bar expands the stand: 7.5 a minute, a shelf of 30, seven crafts of input")
	check(w.events.size() == 1 and w.events[0].contains("grew to level 2"), "and says so: \"%s\"" % w.events[0])
	w.logistics.pay_supplier(stand, 3.0)
	check(is_equal_approx(v.growth.xp, 50.0), "takings from customers are not experience: only money the player gives")
	check(is_equal_approx(stand.value(), 40.0 + 50.0), "the business is now worth its $40 rebuild cost plus $50 of experience")
	w.gun.gift(v, 75.0)
	check(stand.level == 3 and is_equal_approx(stand.rate_per_min, 6.0 * 1.25 * 1.25), "level 3 took $75 more (125 in all)")
	var tent_w := World.new()
	var keeper := tent_w.add_vendor("tent", Vector2.ZERO, 0.0, false, false)
	var tent := tent_w.machine_of(keeper)
	tent_w.gun.gift(keeper, 50.0)
	check(tent.capacity() == 5 and tent.shelter.capacity == 5, "a tent grows by a bed per level (4 to 5)")
	var bw := World.new()
	var kp := bw.add_food_bank(Vector2.ZERO)
	var fbank := bw.food_bank_of(kp)
	bw.gun.gift(kp, 50.0)
	check(fbank.level == 2 and fbank.output.caps["flour"] == 40, "a food bank grows with its keeper: shelves of 40 at level 2")
	var dw := World.new()
	var drifter := dw.add_drifter(Vector2.ZERO)
	dw.gun.gift(drifter, 55.0)
	check(drifter.growth.level == 2 and dw.events.size() == 1, "a drifter levels up too (there's no shop to expand yet)")
	var pw := World.new()
	var pickup := pw.add_drifter(Vector2.ZERO)
	var loose := pw.gun.fire(30.0, "gift")
	pw.gun.land(loose, Vector2(0, 0.5))
	pw.cash.collect(pickup, loose)
	check(is_equal_approx(pickup.growth.xp, 30.0), "a bill an NPC picks up is experience for them: it is the player's money")
	var hw := World.new()
	var hv := hw.add_vendor("bakery", Vector2.ZERO)
	var hb := hw.gun.fire(10.0, "gift")
	hw.gun.hit(hb, hv)
	check(is_equal_approx(hv.growth.xp, 10.0), "and a bill that hits them counts the same")


func test_a_well_funded_business_costs_more() -> void:
	note("invest: a business that has been given a lot is worth more, so the same money buys less of it")
	var w := World.new()
	var fresh := w.add_vendor("bakery", Vector2(0, 0))
	var funded := w.add_vendor("bakery", Vector2(20, 0))
	w.gun.gift(funded, 200.0)
	check(is_equal_approx(w.machine_of(fresh).value(), 40.0) and is_equal_approx(w.machine_of(funded).value(), 240.0), "the funded bakery is worth $240, a fresh one $40")
	var a := w.gun.invest(fresh, 20.0)
	var b := w.gun.invest(funded, 20.0)
	note("    $20 buys %.0f%% of the fresh bakery and %.1f%% of the funded one" % [a * 100.0, b * 100.0])
	check(b < a / 3.0, "$20 buys far less of it (%.1f%% against %.0f%%)" % [b * 100.0, a * 100.0])
	check(w.machine_of(funded).investable() > 100.0, "and far more can be invested in it before the cap ($%.0f)" % w.machine_of(funded).investable())


# ---------------------------------------------------------------- the whole town


func test_giving_money_levels_the_hero_up() -> void:
	note("the hero: every dollar they give away is experience for them, on the same curve as everyone")
	var w := World.new()
	w.add_player(Vector2(0, 0), 0.0)
	var vendor := w.add_vendor("bakery", Vector2(10, 0), 0.0, false, false)
	var drifter := w.add_drifter(Vector2(20, 0), 0.0)
	check(w.player.growth.level == 1 and w.player.growth.xp == 0.0, "the hero starts at level 1 with no experience")
	w.gun.gift(drifter, 30.0)
	check(is_equal_approx(w.player.growth.xp, 30.0) and w.player.growth.level == 1, "a $30 gift is $30 of experience")
	w.gun.gift(drifter, 30.0)
	check(w.player.growth.level == 2 and is_equal_approx(w.player.growth.xp, 60.0) and is_equal_approx(w.player.growth.progress(), 10.0 / 75.0), "$60 in all takes them past the $50 for level 2, with $10 of the next $75 done")
	check(w.events.any(func(e): return "you reached level 2" in e), "and the town is told")
	var r := w.gun.hit_contract(w.gun.fire_contract(30.0), vendor)
	check(is_equal_approx(w.player.growth.xp, 60.0 + r.amount), "an accepted contract counts, but only the accepted $%.0f" % r.amount)
	var xp := w.player.growth.xp
	var b := w.gun.fire(5.0, "gift")
	w.gun.land(b, Vector2(3, 3))
	w.player.pos = Vector2(3, 3)
	w.cash.collect_for_player()
	w.cash.collect(drifter, w.gun.fire(2.0, "gift"))
	check(w.player.growth.xp == xp, "picking up loose money, or others doing so, is not experience for the hero")
	check(Growth.total_for(3) == 125.0, "the curve is the one everyone has (level 3 at $125 in all)")
